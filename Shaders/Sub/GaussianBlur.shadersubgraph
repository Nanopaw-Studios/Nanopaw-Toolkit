    "m_SourceType": 1,
    "m_FunctionName": "GaussianBlur",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float4 col = float4(0.0, 0.0, 0.0, 0.0);\nfloat kernelSum = 0.0;\n\nint upper = ((Blur - 1) / 2);\nint lower = -upper;\n\nfor (int x = lower; x <= upper; ++x)\n{\n    for (int y = lower; y <= upper; ++y)\n    {\n        kernelSum++;\n\n        float2 offset = float2(Texture_TexelSize.x * x, Texture_TexelSize.y * y);\n        col += SAMPLE_TEXTURE2D(Texture, Sampler, UV + offset);\n    }\n}\n\ncol /= kernelSum;\nOut_RGB = float3(col.r, col.g, col.b);\nOut_Alpha = col.a;"
}

